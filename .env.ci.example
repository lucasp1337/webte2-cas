# CI environment template.
#
# Copy to `.env` at the start of any CI job that runs `docker compose` or
# `php artisan` against the codebase:
#
#     cp .env.ci.example .env
#
# Differences from `.env.example`:
#   - service hostnames point at 127.0.0.1 (GitHub Actions services), not
#     `mysql` / `redis` / `octave-bridge` (the dev compose hostnames)
#   - `OCTAVE_BRIDGE_URL` points at localhost:8001 (the port published in
#     docker-compose.ci.yml so the runner can reach the bridge over HTTP)
#   - debug, locale, and APP_URL kept identical to dev so test output is stable
#   - `CAS_SLOWDOWN_MS=0` so integration tests are not artificially throttled
#   - secrets left blank (or default-but-non-sensitive) — CI does not need real values

# App
APP_NAME=WEBTE2
APP_ENV=testing
APP_KEY=                                  # populated by `php artisan key:generate` after copy
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=sk
APP_FALLBACK_LOCALE=en

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database (GitHub Actions service)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=webte2_test
DB_USERNAME=root
DB_PASSWORD=root

# Redis (GitHub Actions service)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=null

# Mail (CI uses array driver — never sends, never errors)
MAIL_MAILER=array
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="noreply@webte2.test"
MAIL_FROM_NAME="${APP_NAME}"

# Horizon (CI never serves /horizon)
HORIZON_ADMIN_TOKEN=ci-token-not-secret

# CAS / Octave bridge
# Bridge port is published to localhost via docker-compose.ci.yml so PHP integration
# tests running on the GitHub-hosted runner (outside the docker network) can reach it.
OCTAVE_BRIDGE_URL=http://localhost:8001
OCTAVE_BRIDGE_TIMEOUT_SECONDS=10
OCTAVE_SESSION_IDLE_HOURS=24
SIMULATION_OCTAVE_TIMEOUT_SECONDS=15
CAS_SLOWDOWN_MS=0
CAS_API_KEY_PLAINTEXT=ci-test-key-not-secret
CAS_COMMAND_MAX_LENGTH=4096
CAS_RATE_LIMIT_PER_MINUTE=120

# Request logging
REQUEST_LOG_RETENTION_DAYS=90

# CSV export
CSV_EXPORT_LARGE_THRESHOLD=10000

# OpenAPI / PDF
OPENAPI_PDF_TIMEOUT_SECONDS=60
BROWSERSHOT_CHROME_PATH=/usr/bin/chromium

# Statistics
STATS_COOLDOWN_MINUTES=10
STATS_ANON_TOKEN_SALT=ci-salt-not-secret
GEOLITE_DB_PATH=/var/geolite/GeoLite2-City.mmdb
GEOLITE_LICENSE_KEY=

# Frontend
VITE_APP_URL="${APP_URL}"
