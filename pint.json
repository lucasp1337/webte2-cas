{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": true,
        "no_unused_imports": true,
        "ordered_imports": { "sort_algorithm": "alpha" },
        "final_class": true,
        "void_return": true
    },
    "exclude": ["bootstrap/cache", "storage", "vendor", "node_modules", "public/build"]
}
