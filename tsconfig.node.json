{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "allowJs": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "isolatedModules": true,
        "composite": true,
        "emitDeclarationOnly": true,
        "skipLibCheck": true
    },
    "include": ["vite.config.ts", "vitest.config.ts", "eslint.config.js"]
}
