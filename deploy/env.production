# Production .env template for node30.webte.fei.stuba.sk.
#
# Copy to .env at the repo root on the server, fill every CHANGE_ME_* slot,
# then run deploy/deploy.sh. Generate strong random values with:
#
#   openssl rand -base64 48 | tr -d '/+=' | head -c 48
#
# APP_KEY is generated by `php artisan key:generate` and does not need to be
# filled by hand.

# App
APP_NAME=WEBTE2
APP_ENV=production
APP_KEY=                                  # filled by `php artisan key:generate`
APP_DEBUG=false
APP_URL=https://node30.webte.fei.stuba.sk
APP_LOCALE=sk
APP_FALLBACK_LOCALE=en

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=warning

# Database
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=webte2
DB_USERNAME=webte2
DB_PASSWORD=CHANGE_ME_STRONG_RANDOM
# Only consumed at first volume init; keep stable for the lifetime of the
# mysql_data volume. If you wipe the volume, this and DB_PASSWORD must be
# re-set together.
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_RANDOM

# Redis (cache, queue, session)
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_RANDOM
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
# Behind the host nginx (TLS-terminating proxy), cookies MUST be secure-only.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=null

# Mail (production: leave as log unless you have SMTP credentials)
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="noreply@node30.webte.fei.stuba.sk"
MAIL_FROM_NAME="${APP_NAME}"

# Horizon (queue dashboard, gated)
# Generate a 64+ char random token. Bind your session once at
# https://node30.webte.fei.stuba.sk/horizon?token=YOUR_TOKEN
HORIZON_ADMIN_TOKEN=CHANGE_ME_STRONG_RANDOM_64_CHARS

# Telescope — MUST stay off in production (captures X-API-Key on every request).
TELESCOPE_ENABLED=false

# CAS / Octave bridge
OCTAVE_BRIDGE_URL=http://octave-bridge:8001
OCTAVE_BRIDGE_TIMEOUT_SECONDS=10
OCTAVE_SESSION_IDLE_HOURS=24
SIMULATION_OCTAVE_TIMEOUT_SECONDS=15
CAS_SLOWDOWN_MS=500
# Seeded initial API key for production. Generate, save in your password
# manager, and rotate via `php artisan cas:create-api-key production`.
CAS_API_KEY_PLAINTEXT=CHANGE_ME_STRONG_RANDOM
CAS_COMMAND_MAX_LENGTH=4096
CAS_RATE_LIMIT_PER_MINUTE=30

# Request logging
REQUEST_LOG_RETENTION_DAYS=90

# CSV export
CSV_EXPORT_LARGE_THRESHOLD=10000

# OpenAPI / PDF
OPENAPI_PDF_TIMEOUT_SECONDS=60
BROWSERSHOT_CHROME_PATH=/usr/bin/chromium

# Statistics
STATS_COOLDOWN_MINUTES=10
STATS_ANON_TOKEN_SALT=CHANGE_ME_STRONG_RANDOM
GEOLITE_DB_PATH=/var/geolite/GeoLite2-City.mmdb
# Required for geo-tagging. Get a free key at
#   https://www.maxmind.com/en/geolite2/signup
# The web/cli images bake the .mmdb in at build time via BuildKit secret.
GEOLITE_LICENSE_KEY=CHANGE_ME_MAXMIND_LICENSE_KEY

# Frontend
VITE_APP_URL="${APP_URL}"
