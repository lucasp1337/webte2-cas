# App
APP_NAME=WEBTE2
APP_ENV=local
APP_KEY=                                  # set in deploy via `php artisan key:generate`
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=sk
APP_FALLBACK_LOCALE=en

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=webte2
DB_USERNAME=webte2
DB_PASSWORD=changeme                      # set in deploy
# Root password is only consumed by the mysql container at first init. Required
# in compose; if you wipe the mysql_data volume you must keep this consistent.
MYSQL_ROOT_PASSWORD=changeme              # set in deploy

# Redis (cache, queue, session)
REDIS_CLIENT=predis                       # phpredis C extension is not yet built for PHP 8.5
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
# Cookie security flags.
# SESSION_SECURE_COOKIE: leave blank (auto = secure when HTTPS) in local dev.
# Production behind a TLS-terminating proxy should set this to `true` explicitly.
SESSION_SECURE_COOKIE=
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=null

# Mail (dev: log driver; production swaps to SMTP)
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="noreply@webte2.local"
MAIL_FROM_NAME="${APP_NAME}"

# Horizon (queue dashboard, gated)
# Set to a 64+ char random string. Visit /horizon?token=YOUR_TOKEN once to bind the session.
HORIZON_ADMIN_TOKEN=

# Telescope (request inspector, dev only)
# Off by default — Telescope captures every request including the X-API-Key
# header. Local devs can flip to `true`; production must keep it off.
TELESCOPE_ENABLED=false

# CAS / Octave bridge
OCTAVE_BRIDGE_URL=http://octave-bridge:8001
OCTAVE_BRIDGE_TIMEOUT_SECONDS=10
OCTAVE_SESSION_IDLE_HOURS=24              # PruneStaleOctaveSessionsJob deletes .mat files older than this
SIMULATION_OCTAVE_TIMEOUT_SECONDS=15      # per-simulation request timeout against the bridge
CAS_SLOWDOWN_MS=500
CAS_API_KEY_PLAINTEXT=                    # initial seeded key for local dev; rotate in production
CAS_COMMAND_MAX_LENGTH=4096
CAS_RATE_LIMIT_PER_MINUTE=30

# Request logging
REQUEST_LOG_RETENTION_DAYS=90             # PruneOldRequestLogsJob deletes rows older than this

# CSV export
CSV_EXPORT_LARGE_THRESHOLD=10000          # rows above this go through GenerateLargeCsvExportJob

# OpenAPI / PDF
OPENAPI_PDF_TIMEOUT_SECONDS=60            # GenerateApiDocsPdfJob hard timeout
BROWSERSHOT_CHROME_PATH=/usr/bin/chromium # path inside the cli container

# Statistics
STATS_COOLDOWN_MINUTES=10                 # debounce window per (animation, ip-hash)
STATS_ANON_TOKEN_SALT=                    # set in deploy; salts IP hashes so they cannot be rainbow-tabled
# Geolocation API for anonymous usage stats. Free, keyless ip-api.com service.
GEOLOCATION_ENDPOINT=http://ip-api.com/json

# Frontend
VITE_APP_URL="${APP_URL}"
